---
import Layout from '../layouts/Layout.astro';
import Upozorneni from '../components/Upozorneni.astro';
import info from '../data/info.json';

const dnes = new Date().toISOString().slice(0, 10);
const upozorneni = info.upozorneni.filter((u) => !u.zobrazitDo || u.zobrazitDo >= dnes);
---

<Layout>
  <div class="grid-container">
    <div class="grid-x grid-padding-x">
      <div class="small-7 medium-5 large-4 cell informace-container">
        <div class="informace">
          <h1><img src="/assets/img/optik-mihula-logo.svg" alt="Optik Mihula" /></h1>
          {upozorneni.map((u) => <Upozorneni {...u} />)}
          <h2 class="h4">Otevírací doba</h2>
          <table class="unstriped">
            {info.oteviraciDoba.map((d) => (
              <tr>
                <th>{d.den}</th>
                <td>{d.dopoledne}</td>
                <td>{d.odpoledne}</td>
              </tr>
            ))}
          </table>

          <div class="kontakty">
            {info.telefony.map((t) => (
              <div class="kontakt">
                <img src="/assets/img/telefon-icon.svg" alt="Telefon" /> <a href={`tel:${t.tel}`}>{t.zobrazit}</a>
              </div>
            ))}
            <div class="kontakt"><a href={`mailto:${info.email}`}>{info.email}</a></div>
          </div>

          <div class="adresa">
            <img src="/assets/img/misto-icon.svg" alt="Místo" /> <a href={info.adresa.mapa}>{info.adresa.nazev}</a>, <br />
            {info.adresa.ulice}
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
