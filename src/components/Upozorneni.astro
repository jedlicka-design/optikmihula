---
interface Props {
  text: string;
  /** Poslední den zobrazení (YYYY-MM-DD). Po něm se upozornění skryje. */
  zobrazitDo?: string;
}

const { text, zobrazitDo } = Astro.props;
---

<div class="upozorneni" role="status" data-zobrazit-do={zobrazitDo}>
  <img src="/assets/img/upozorneni-icon.svg" alt="" width="28" height="28" />
  <p>{text}</p>
</div>

<script is:inline>
  (function () {
    var d = new Date();
    var dnes = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    document.querySelectorAll('.upozorneni[data-zobrazit-do]').forEach(function (el) {
      if (dnes > el.dataset.zobrazitDo) el.remove();
    });
  })();
</script>

<style>
  .upozorneni {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: -1.5rem 0 2rem;
    padding: 0.75rem 1rem;
    border-left: 4px solid #7aa402;
    border-radius: 0 0.5rem 0.5rem 0;
    background: rgba(122, 164, 2, 0.12);
  }
  .upozorneni img {
    flex: none;
  }
  .upozorneni p {
    margin: 0;
    font-weight: 700;
    color: #204419;
  }
</style>
