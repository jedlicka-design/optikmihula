---
interface Props {
  text: string;
  /** Poslední den zobrazení (YYYY-MM-DD). Po něm se upozornění skryje. */
  zobrazitDo?: string;
}

const { text, zobrazitDo } = Astro.props;
---

<div class="upozorneni" role="status" data-zobrazit-do={zobrazitDo}>
  <span class="ikona" aria-hidden="true"></span>
  <p>{text}</p>
</div>

<script is:inline>
  (function () {
    var d = new Date();
    var dnes = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    document.querySelectorAll('.upozorneni[data-zobrazit-do]').forEach(function (el) {
      if (dnes > el.dataset.zobrazitDo) el.remove();
    });
  })();
</script>

<style>
  .upozorneni {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: -1.5rem 0 2rem;
    padding: 0.6rem 0.9rem;
    border-radius: 0.5rem;
    background: #e8710a;
    box-shadow: 0 2px 8px rgba(232, 113, 10, 0.35);
  }
  .ikona {
    flex: none;
    width: 22px;
    height: 22px;
    background: #fff;
    -webkit-mask: url(/assets/img/upozorneni-icon.svg) center / contain no-repeat;
    mask: url(/assets/img/upozorneni-icon.svg) center / contain no-repeat;
  }
  .upozorneni p {
    margin: 0;
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
  }
</style>
